{
  "name": "dsh-subagent-serializer",
  "description": "Serialize subagent starts with a configurable delay for single-concurrency local inference, and hold each delegation tool call open until the child settles (foreground semantics restored for DSH >= 0.2.1)",
  "version": "0.2.5",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "templates/agents.md",
    "README.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "subagent",
    "serialize",
    "single-concurrency",
    "delay"
  ]
}
